# Print the status file path for a working directory.
set -euo pipefail

# shellcheck source=../lib/gellee.sh
. "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/../lib/gellee.sh"

gellee_load_config
dir=${1:-$PWD}
key=$(gellee_project_key "$dir") ||
  gellee_die "not inside a configured root: $dir"
printf '%s/%s.md\n' "$GELLEE_STATE" "$key"
